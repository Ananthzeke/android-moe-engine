+enum llama_expert_role {
+    LLAMA_EXPERT_GATE,
+    LLAMA_EXPERT_UP,
+    LLAMA_EXPERT_DOWN,
+    LLAMA_EXPERT_GATE_UP,
+    LLAMA_EXPERT_SHARED_GATE,
+    LLAMA_EXPERT_SHARED_UP,
+    LLAMA_EXPERT_SHARED_DOWN,
+    LLAMA_EXPERT_SHARED_GATE_INP,
+};
+
+struct llama_expert_consumer {
+    int32_t layer;
+    enum llama_expert_role role;
+    const struct ggml_tensor * tensor;
+    bool shared;
+    uint32_t max_selected;
+};
+
+// Internal source-derived routed/shared expert consumers.
