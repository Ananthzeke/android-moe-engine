+std::vector<llama_expert_consumer> llama_internal_get_expert_consumers(const llama_model * model) {
+    std::vector<llama_expert_consumer> result;
+    for (size_t il = 0; il < model->layers.size(); ++il) {
+        const auto & layer = model->layers[il];
+        const std::pair<const ggml_tensor *, llama_expert_role> routed[] = {
+            {layer.ffn_gate_exps,    LLAMA_EXPERT_GATE},
+            {layer.ffn_up_exps,      LLAMA_EXPERT_UP},
+            {layer.ffn_down_exps,    LLAMA_EXPERT_DOWN},
+            {layer.ffn_gate_up_exps, LLAMA_EXPERT_GATE_UP},
+        };
+        for (const auto & [tensor, role] : routed) {
+            if (tensor != nullptr) {
+                result.push_back({(int32_t) il, role, tensor, false, (uint32_t) model->hparams.n_expert_used()});
+            }
+        }
+        const std::pair<const ggml_tensor *, llama_expert_role> shared[] = {
+            {layer.ffn_gate_shexp,     LLAMA_EXPERT_SHARED_GATE},
+            {layer.ffn_up_shexp,       LLAMA_EXPERT_SHARED_UP},
+            {layer.ffn_down_shexp,     LLAMA_EXPERT_SHARED_DOWN},
+            {layer.ffn_gate_inp_shexp, LLAMA_EXPERT_SHARED_GATE_INP},
+        };
+        for (const auto & [tensor, role] : shared) {
+            if (tensor != nullptr) {
+                result.push_back({(int32_t) il, role, tensor, true, 0});
+            }
+        }
+    }
+    return result;
+}
+
 int32_t llama_model_n_expert(const struct llama_model * model) {
     return model->hparams.n_expert;
 }
