+// Project-provided expert materialization hook. One active generation is the MVP
+// contract; g_moe_staged is shared by the graph's worker threads after the barrier.
+static ggml_moe_materialize_fn g_moe_materializer = NULL;
+static int g_moe_outcome = GGML_MOE_PASS_THROUGH;
+static int g_moe_error_latched = 0;
+
+void ggml_moe_reset(void) {
+    g_moe_outcome = GGML_MOE_PASS_THROUGH;
+    g_moe_error_latched = 0;
+}
+
+void ggml_moe_set_materializer(ggml_moe_materialize_fn materializer) {
+    g_moe_materializer = materializer;
+    ggml_moe_reset();
+}
+
+bool ggml_moe_materializer_active(void) {
+    return g_moe_materializer != NULL;
+}
+
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((weak))
+#endif
+uint32_t ggml_moe_max_slots(void) {
+    return 0;
+}
+
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((weak))
+#endif
+const struct ggml_tensor * ggml_moe_staged_weights(void) {
+    return NULL;
+}
+
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((weak))
+#endif
+const struct ggml_tensor * ggml_moe_staged_ids(void) {
+    return NULL;
+}
