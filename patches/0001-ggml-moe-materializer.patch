+#pragma once
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ggml_tensor;
+
+// Optional expert materialization hook. It is called once per MUL_MAT_ID op by
+// thread 0. The outcome is published at the existing worker barrier. STAGED
+// directs the kernel to read the staged descriptors; PASS_THROUGH keeps the
+// original tensors. CANCELLED and FAILED stop the operator without computing
+// partial output. The staged descriptors must stay valid until the next call.
+enum ggml_moe_outcome {
+    GGML_MOE_PASS_THROUGH = 0,
+    GGML_MOE_STAGED       = 1,
+    GGML_MOE_CANCELLED    = 2,
+    GGML_MOE_FAILED       = 3,
+};
+
+typedef int (*ggml_moe_materialize_fn)(const struct ggml_tensor * weights,
+                                       const struct ggml_tensor * ids);
+
+// Installing or removing a materializer starts a fresh failure state.
+void ggml_moe_set_materializer(ggml_moe_materialize_fn materializer);
+// Clear the outcome and the error latch left by a failed or cancelled graph. The
+// caller must hold exclusive ownership: no graph may be computing, and the context
+// that ran the failed graph must already be destroyed.
+void ggml_moe_reset(void);
+bool ggml_moe_materializer_active(void);
+uint32_t ggml_moe_max_slots(void);
+const struct ggml_tensor * ggml_moe_staged_weights(void);
+const struct ggml_tensor * ggml_moe_staged_ids(void);
+
+#ifdef __cplusplus
+}
+#endif
